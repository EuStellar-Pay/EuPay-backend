PORT=3001

# Stellar network config
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=TESTNET

# Deployed Soroban contract IDs
CONTRACT_PAYROLL_STREAM=<your-payroll-stream-contract-id>
CONTRACT_TREASURY_VAULT=<your-treasury-vault-contract-id>

# A funded testnet address used as the source account for contract simulations (reads).
# This account needs to exist on-chain but does NOT need to sign anything.
SIM_SOURCE_ADDRESS=<any-funded-testnet-stellar-address>
